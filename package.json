{
  "name": "voyager-ventures",
  "version": "0.1.0",
  "private": true,
  "description": "Voyager Ventures — an interactive multiscale scientific exploration platform (Atomic + Cosmic modes).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:elements": "node --experimental-strip-types scripts/ingestion/pubchem-elements.ts",
    "data:molecules": "node --experimental-strip-types scripts/ingestion/pubchem-molecules.ts",
    "data:horizons": "node --experimental-strip-types scripts/ingestion/jpl-horizons.ts",
    "data:all": "npm run data:elements && npm run data:molecules && npm run data:horizons && npm run data:spectra",
    "data:validate": "node --experimental-strip-types scripts/validation/validate-datasets.ts",
    "screenshots": "playwright test --config tests/e2e/playwright.config.ts",
    "models:build": "/Applications/Blender.app/Contents/MacOS/Blender -b --factory-startup --python scripts/blender/build_voyager.py -- \"$PWD\"",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "predev": "node scripts/build/copy-vendor.mjs",
    "prebuild": "node scripts/build/copy-vendor.mjs",
    "data:spectra": "node --experimental-strip-types scripts/ingestion/nist-asd.ts"
  },
  "dependencies": {
    "@rdkit/rdkit": "^2026.9.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
